# Copie este arquivo para .env e preencha com os dados do seu projeto Firebase
# (console.firebase.google.com → Configurações do projeto → Seus apps → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- IA (ficam só no servidor; NÃO comece com VITE_) ----
# Sua chave da Anthropic (console.anthropic.com → API Keys). Usada só para você.
ANTHROPIC_API_KEY=
# E-mail(s) que usam a IA paga (Claude). Separe vários por vírgula.
DONO_EMAILS=advmiltonsoares@gmail.com
# Chave grátis do Gemini (aistudio.google.com → Get API key). Usada pela família e amigos.
GEMINI_API_KEY=
# Opcional: troque o modelo do Gemini se o Google mudar o nome.
GEMINI_MODELO=gemini-3.5-flash-lite
# Mesmo valor de VITE_FIREBASE_PROJECT_ID (o servidor usa para conferir o login).
FIREBASE_PROJECT_ID=
# Só para testes sem Firebase: "sim" libera a IA grátis sem login. Não use no app publicado.
PERMITIR_SEM_LOGIN=
